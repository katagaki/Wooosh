<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Required on many devices to receive mDNS multicast while browsing. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Android 17 (SDK 37) Local Network Protections: without this, NsdManager
         registerService/discoverServices throw SecurityException. Runtime-granted. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!-- QR pairing scan path (PROTOCOL.md §4.2). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Transfer foreground service (DESIGN.md §7). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Direct write to public Downloads on API 26–28 only (DESIGN.md §6). -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Package visibility for the "files arrived" notification. Without these, API 30+
         filtering makes resolveActivity return null for every viewer on the device, and
         the notification would always fall back to opening Wooosh instead of the file. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW_DOWNLOADS" />
        </intent>
    </queries>

    <application
        android:name=".WoooshApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Wooosh">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Direct Share target declaration (DESIGN.md §8). -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- System share sheet entry (DESIGN.md §8): stages the shared URIs, then opens
             the device list armed to send on tap. -->
        <activity
            android:name=".share.ShareTargetActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Wooosh">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- Transfer progress + wake lock while a transfer is active (DESIGN.md §7). -->
        <service
            android:name=".transfer.TransferService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>
