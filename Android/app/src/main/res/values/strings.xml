        <item quantity="one">Received %1$d file</item>
        <item quantity="other">Received %1$d files</item>
    </plurals>
    <!-- Summary of a finished receive. %2$s is how long it took. -->
    <plurals name="transfer_done_received_in">
        <item quantity="one">Received %1$d file in %2$s</item>
        <item quantity="other">Received %1$d files in %2$s</item>
    </plurals>
    <!-- Summary when every file in a transfer failed. -->
    <plurals name="transfer_done_failed">
        <item quantity="one">Couldn\'t transfer %1$d file</item>
        <item quantity="other">Couldn\'t transfer %1$d files</item>
    </plurals>
    <!-- Summary when only some files got through. %1$d is how many did. -->
    <plurals name="transfer_done_partial">
        <item quantity="one">Transferred %1$d of %2$d file</item>
        <item quantity="other">Transferred %1$d of %2$d files</item>
    </plurals>
    <!-- Notification title when several transfers run at once. -->
    <plurals name="notification_title_multiple">
        <item quantity="one">In progress: %1$d transfer</item>
        <item quantity="other">In progress: %1$d transfers</item>
    </plurals>
    <!-- Notification title when files have finished arriving. Tapping it opens them. -->
    <plurals name="notification_received_title">
        <item quantity="one">Received %1$d File</item>
        <item quantity="other">Received %1$d Files</item>
    </plurals>
