<?xml version="1.0" encoding="utf-8"?>
<!-- Paper airplane in perspective: the far wing is foreshortened and dimmer, so
     the form reads as a solid object banking away rather than a flat arrow.
     Geometry is pre-scaled into the 72dp safe zone of the 108dp adaptive-icon
     canvas, so nothing clips under any launcher mask.

     Placed by opacity-weighted area centroid, not bounding box: the nose is a
     thin point and the wing carries the mass, so centring the box leaves the
     glyph looking shifted up and to the right. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1124"
    android:viewportHeight="124">
    <path
        android:pathData="M 737.6,290.9 L 427.6,652.9 Q 488.3,696.3 566.5,745.9 Z"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.55" />
    <path
        android:pathData="M 737.6,290.9 L 427.6,652.9 L 446.2,754.6 Q 449.9,767.0 459.8,755.9 Z"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.78" />
    <path
        android:pathData="M 737.6,290.9 L 276.3,473.1 Q 268.9,479.3 277.5,484.3 L 427.6,652.9 Z"
        android:fillColor="#FFFFFF" />
</vector>
