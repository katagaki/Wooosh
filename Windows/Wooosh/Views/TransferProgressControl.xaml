<UserControl
    x:Class="Wooosh.Views.TransferProgressControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:loc="using:Wooosh.Localization"
    mc:Ignorable="d">

    <UserControl.Resources>
        <loc:BoolToVisibilityConverter x:Key="HiddenWhenFinished" Invert="True" />
    </UserControl.Resources>

    <Border
        Padding="16"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <StackPanel Spacing="8">
            <TextBlock
                Style="{ThemeResource BodyStrongTextBlockStyle}"
                Text="{x:Bind Transfer.Header, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />

            <!-- Foreground is left alone so the bar follows the system accent. -->
            <ProgressBar
                Maximum="100"
                Value="{x:Bind Transfer.PercentComplete, Mode=OneWay}" />

            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="{x:Bind Transfer.StatusLine, Mode=OneWay}"
                TextWrapping="Wrap" />

            <Button
                HorizontalAlignment="Left"
                Click="OnCancelClick"
                Content="{loc:Localize Key=ActionCancelTransfer}"
                Visibility="{x:Bind Transfer.IsFinished, Mode=OneWay, Converter={StaticResource HiddenWhenFinished}}" />
        </StackPanel>
    </Border>
</UserControl>
