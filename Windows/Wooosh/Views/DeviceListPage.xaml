<Page
    x:Class="Wooosh.Views.DeviceListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:loc="using:Wooosh.Localization"
    xmlns:peers="using:Wooosh.Peers"
    xmlns:views="using:Wooosh.Views"
    xmlns:vm="using:Wooosh.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <loc:LocalizeConverter x:Key="Localize" />
        <loc:StaleOpacityConverter x:Key="StaleOpacity" StaleOpacity="0.4" />
        <loc:StringToVisibilityConverter x:Key="StringToVisibility" />
    </Page.Resources>

    <Grid Padding="0,0,0,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <CommandBar Grid.Row="0" DefaultLabelPosition="Right" HorizontalAlignment="Left" Background="Transparent">
            <AppBarButton
                Click="OnRefreshClick"
                Icon="Refresh"
                Label="{loc:Localize Key=ActionRefresh}" />
            <AppBarButton
                Click="OnPairClick"
                Icon="Link"
                Label="{loc:Localize Key=ActionPairDevice}" />
            <!-- The internet path (PROTOCOL.md §9) is a command here, not a synthetic row: the ListView binds straight to the append-only collection. -->
            <AppBarButton
                Click="OnOtherDeviceClick"
                Icon="Globe"
                Label="{loc:Localize Key=OtherDeviceTitle}" />
            <AppBarButton
                Click="OnSettingsClick"
                Icon="Setting"
                Label="{loc:Localize Key=ActionSettings}" />
        </CommandBar>

        <!-- A failed core start is stated outright, never left looking like "nobody is nearby". -->
        <InfoBar
            Grid.Row="1"
            Margin="16,0,16,8"
            IsClosable="False"
            IsOpen="True"
            Message="{x:Bind ViewModel.StartupError, Mode=OneWay}"
            Severity="Error"
            Visibility="{x:Bind ViewModel.StartupError, Mode=OneWay, Converter={StaticResource StringToVisibility}}" />

        <ItemsControl
            Grid.Row="2"
            Margin="16,0,16,8"
            ItemsSource="{x:Bind ViewModel.Transfers, Mode=OneWay}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TransferViewModel">
                    <views:TransferProgressControl Margin="0,0,0,8" Transfer="{x:Bind}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel
            Grid.Row="3"
            Margin="32"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind EmptyStateVisibility, Mode=OneWay}">
            <TextBlock
                HorizontalAlignment="Center"
                Style="{ThemeResource SubtitleTextBlockStyle}"
                Text="{loc:Localize Key=EmptyTitle}" />
            <TextBlock
                HorizontalAlignment="Center"
                MaxWidth="420"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource BodyTextBlockStyle}"
                Text="{loc:Localize Key=EmptyBody}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <TextBlock
                HorizontalAlignment="Center"
                MaxWidth="420"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.VisibilityExplanation, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <Button
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                Click="OnPairClick"
                Content="{loc:Localize Key=ActionPairDevice}"
                Style="{ThemeResource AccentButtonStyle}" />
            <!-- Repeated from the command bar: an empty list is exactly when the internet path is wanted. -->
            <Button
                HorizontalAlignment="Center"
                Click="OnOtherDeviceClick"
                Content="{loc:Localize Key=OtherDeviceTitle}" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="{loc:Localize Key=OtherDeviceSubtitle}" />
        </StackPanel>

        <!-- No sort, grouping or CollectionViewSource: the collection is already in first-discovery order and must never be re-ordered (DESIGN.md §5). -->
        <ListView
            x:Name="PeerList"
            Grid.Row="3"
            Padding="8,0,8,0"
            IsItemClickEnabled="True"
            ItemClick="OnPeerClick"
            ItemsSource="{x:Bind ViewModel.Peers, Mode=OneWay}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="peers:Peer">
                    <!-- A departed peer dims and stops responding in place, same index and height: rows shifting under the pointer cause mis-sends. -->
                    <Grid
                        Padding="8,10"
                        ColumnSpacing="12"
                        IsHitTestVisible="{x:Bind IsAvailable, Mode=OneWay}"
                        Opacity="{x:Bind IsStale, Mode=OneWay, Converter={StaticResource StaleOpacity}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Grid.Column="0"
                            AutomationProperties.Name="{x:Bind DeviceKindKey, Mode=OneWay, Converter={StaticResource Localize}}"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="20"
                            Glyph="{x:Bind Glyph, Mode=OneWay}" />

                        <StackPanel Grid.Column="1">
                            <TextBlock
                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind Label, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind State, Mode=OneWay}" />
                        </StackPanel>

                        <FontIcon
                            Grid.Column="2"
                            AutomationProperties.Name="{loc:Localize Key=PeerBadgePaired}"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="14"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Glyph="&#xE73E;"
                            Visibility="{x:Bind IsPaired, Mode=OneWay}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
