<Page
    x:Class="Wooosh.Views.PairingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:loc="using:Wooosh.Localization"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Margin="24" MaxWidth="640" Spacing="24">

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    AutomationProperties.Name="{loc:Localize Key=ActionBack}"
                    Click="OnBackClick"
                    Content="&#xE72B;"
                    FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{ThemeResource TitleTextBlockStyle}"
                    Text="{loc:Localize Key=PairingTitle}" />
            </StackPanel>

            <!--
                This device's own code (PROTOCOL.md §4.2 step 1). A PC has no camera in the
                general case, so the paste route below is the primary one and this half is
                for a phone scanning the PC.
            -->
            <StackPanel Spacing="8">
                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{loc:Localize Key=PairingTabMyCode}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource BodyTextBlockStyle}"
                    Text="{loc:Localize Key=PairingShowBody}"
                    TextWrapping="Wrap" />

                <!--
                    TODO(pairing): render the payload as a QR code. There is no QR renderer
                    in the box on Windows, so this is a real dependency decision rather than
                    a stub to fill in: a blank Image element pretending to be a QR code
                    would be worse than the copyable text below.
                -->
                <Border
                    Width="200"
                    Height="200"
                    HorizontalAlignment="Left"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8" />

                <TextBox
                    x:Name="MyCodeBox"
                    AcceptsReturn="True"
                    IsReadOnly="True"
                    TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        x:Name="CopyCodeButton"
                        AutomationProperties.Name="{loc:Localize Key=ActionCopyPairingCode}"
                        Click="OnCopyCodeClick"
                        Content="{loc:Localize Key=ActionCopyCode}" />
                    <Button Click="OnNewCodeClick" Content="{loc:Localize Key=ActionNewCode}" />
                </StackPanel>

                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="{loc:Localize Key=PairingShowExpiry}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!-- Paste route: the desktop equivalent of scanning. -->
            <StackPanel Spacing="8">
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource BodyTextBlockStyle}"
                    Text="{loc:Localize Key=PairingScanBodyDesktop}"
                    TextWrapping="Wrap" />
                <TextBox
                    x:Name="PasteBox"
                    Header="{loc:Localize Key=PairingPasteLabel}"
                    TextWrapping="Wrap" />
                <Button
                    Click="OnPairWithPastedClick"
                    Content="{loc:Localize Key=ActionPairWithPasted}"
                    Style="{ThemeResource AccentButtonStyle}" />
            </StackPanel>

            <InfoBar
                x:Name="PairingStatus"
                IsClosable="False"
                IsOpen="False" />
        </StackPanel>
    </ScrollViewer>
</Page>
