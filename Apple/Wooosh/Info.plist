<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.tsubuzaki.Wooosh</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>wooosh</string>
			</array>
		</dict>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<!-- Wildcard prefix required by BGContinuedProcessingTaskRequest: each
		     submission uses a concrete id under it (BackgroundTransferTask.swift).
		     Ignored on macOS, where BackgroundTasks does not exist. -->
		<string>com.tsubuzaki.Wooosh.transfer.*</string>
	</array>
	<!-- Export compliance. True because the Rust core bundles its own crypto
	     (rustls/ring, ed25519-dalek, blake3) to encrypt transferred file data,
	     so none of Apple's exemptions apply: not OS-provided encryption, not
	     plain HTTPS, and not limited to authentication or signing. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<true/>
	<key>NSBonjourServices</key>
	<array>
		<string>_wooosh._tcp</string>
	</array>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
</dict>
</plist>
