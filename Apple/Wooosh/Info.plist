<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.tsubuzaki.Wooosh</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>wooosh</string>
			</array>
		</dict>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<!-- Wildcard prefix required by BGContinuedProcessingTaskRequest: each
		     submission uses a concrete id under it (BackgroundTransferTask.swift).
		     Ignored on macOS, where BackgroundTasks does not exist. -->
		<string>com.tsubuzaki.Wooosh.transfer.*</string>
	</array>
	<!-- Export compliance. This governs Apple's per-submission questionnaire,
	     not whether Wooosh encrypts: the Rust core does encrypt every transfer
	     (TLS 1.3 via rustls/ring). False because the App Store Connect
	     questionnaire determined that no encryption documentation is required,
	     which means Apple issues no compliance code, and True without a
	     matching ITSEncryptionExportComplianceCode fails upload as ITMS-90592.
	     The separate BIS 5D992.c self-classification report still applies. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSBonjourServices</key>
	<array>
		<string>_wooosh._tcp</string>
	</array>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
</dict>
</plist>
