          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh 無法讀取或寫入檔案。請檢查是否有可用空間，然後重試。"
          }
        }
      }
    },
    "error_key_changed": {
      "comment": "Core error: a paired device presented a different key.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
