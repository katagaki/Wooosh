          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Drugie urządzenie odrzuciło prośbę o sparowanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O outro dispositivo recusou o pedido de pareamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Другое устройство отклонило запрос на связывание."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
