    "error_pairing_not_a_code": {
      "comment": "Shown when a scan produced something that is not a Wooosh pairing code.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist kein Wooosh-Kopplungscode. Scanne den Code, der auf dem anderen Gerät unter „Gerät koppeln“ angezeigt wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That is not a Wooosh pairing code. Scan the code shown under Pair a Device on the other device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eso no es un código de vinculación de Wooosh. Escanea el código que aparece en «Vincular un dispositivo» en el otro dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ne s'agit pas d'un code d'association Wooosh. Scannez le code affiché sous « Associer un appareil » sur l'autre appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo non è un codice di abbinamento Wooosh. Scansiona il codice mostrato sotto «Abbina un dispositivo» sull'altro dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは Wooosh のペアリングコードではありません。相手のデバイスの「デバイスをペアリング」に表示されているコードをスキャンしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh 페어링 코드가 아닙니다. 상대 기기의 ‘기기 페어링’에 표시된 코드를 스캔하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat is geen Wooosh-koppelcode. Scan de code die op het andere apparaat onder ‘Apparaat koppelen’ staat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To nie jest kod parowania Wooosh. Zeskanuj kod widoczny w sekcji „Sparuj urządzenie” na drugim urządzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso não é um código de pareamento do Wooosh. Escaneie o código exibido em “Parear um dispositivo” no outro dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это не код связи Wooosh. Отсканируйте код из раздела «Связать устройство» на другом устройстве."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det är inte en parkopplingskod för Wooosh. Skanna koden som visas under ”Parkoppla en enhet” på den andra enheten."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这不是 Wooosh 配对码。请扫描另一台设备上“配对设备”里显示的配对码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這不是 Wooosh 配對碼。請掃描另一台裝置上「配對裝置」中顯示的配對碼。"
          }
        }
      }
    },
    "error_pairing_required": {
      "comment": "Core error: the other device accepts paired devices only.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät nimmt nur Dateien von Geräten an, mit denen es gekoppelt ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That device only accepts files from devices it has paired with."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese dispositivo solo acepta archivos de dispositivos con los que se ha vinculado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil n'accepte que les fichiers provenant d'appareils avec lesquels il est associé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel dispositivo accetta file solo dai dispositivi con cui è abbinato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのデバイスは、ペアリング済みのデバイスからのファイルのみを受け付けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 기기는 페어링된 기기에서 보낸 파일만 받습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat apparaat accepteert alleen bestanden van apparaten waarmee het gekoppeld is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To urządzenie przyjmuje pliki tylko od sparowanych urządzeń."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse dispositivo só aceita arquivos de dispositivos com os quais foi pareado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это устройство принимает файлы только от связанных устройств."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Enheten tar bara emot filer från enheter den är parkopplad med."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该设备只接受来自已配对设备的文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該裝置只接受來自已配對裝置的檔案。"
          }
        }
      }
    },
    "error_pairing_timeout": {
      "comment": "Shown when a pairing attempt ran out of time.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh konnte das Gerät nicht rechtzeitig erreichen. Prüfe, ob es den Kopplungscode noch anzeigt und ob beide Geräte im selben WLAN sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh couldn't reach that device in time. Check that it is still showing its pairing code and that both devices are on the same Wi-Fi network."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh no ha podido contactar con ese dispositivo a tiempo. Comprueba que siga mostrando su código de vinculación y que ambos dispositivos estén en la misma red Wi-Fi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh n'a pas pu joindre cet appareil à temps. Vérifiez qu'il affiche toujours son code d'association et que les deux appareils sont sur le même réseau Wi-Fi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh non è riuscito a raggiungere quel dispositivo in tempo. Verifica che stia ancora mostrando il codice di abbinamento e che entrambi i dispositivi siano sulla stessa rete Wi-Fi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh は時間内にそのデバイスに接続できませんでした。相手のデバイスにペアリングコードがまだ表示されていること、両方のデバイスが同じ Wi-Fi ネットワークにあることを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh가 제한 시간 안에 해당 기기에 연결하지 못했습니다. 상대 기기에 페어링 코드가 계속 표시되어 있는지, 두 기기가 같은 Wi-Fi 네트워크에 있는지 확인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh kon dat apparaat niet op tijd bereiken. Controleer of het de koppelcode nog toont en of beide apparaten in hetzelfde wifinetwerk zitten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh nie zdążył połączyć się z tym urządzeniem. Sprawdź, czy nadal wyświetla kod parowania i czy oba urządzenia są w tej samej sieci Wi-Fi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Wooosh não conseguiu alcançar esse dispositivo a tempo. Confira se ele ainda está mostrando o código de pareamento e se os dois dispositivos estão na mesma rede Wi-Fi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh не успел связаться с этим устройством. Убедитесь, что оно всё ещё показывает код связи и что оба устройства в одной сети Wi-Fi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh nådde inte enheten i tid. Kontrollera att den fortfarande visar sin parkopplingskod och att båda enheterna är i samma Wi-Fi-nätverk."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh 未能及时连接到该设备。请确认它仍在显示配对码，并且两台设备位于同一 Wi-Fi 网络中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh 未能及時連線到該裝置。請確認它仍在顯示配對碼，且兩台裝置位於同一 Wi-Fi 網路中。"
          }
        }
      }
    },
    "error_protocol": {
      "comment": "Core error: the other device sent something this build does not understand.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das andere Gerät hat etwas gesendet, das Wooosh nicht versteht. Aktualisiere Wooosh auf beiden Geräten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The other device sent something Wooosh did not understand. Update Wooosh on both devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El otro dispositivo ha enviado algo que Wooosh no entiende. Actualiza Wooosh en ambos dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'autre appareil a envoyé quelque chose que Wooosh ne comprend pas. Mettez Wooosh à jour sur les deux appareils."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'altro dispositivo ha inviato qualcosa che Wooosh non capisce. Aggiorna Wooosh su entrambi i dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手のデバイスから、Wooosh が解釈できないデータが送られてきました。両方のデバイスで Wooosh を更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상대 기기가 Wooosh가 이해할 수 없는 내용을 보냈습니다. 두 기기에서 Wooosh를 업데이트하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het andere apparaat stuurde iets dat Wooosh niet begrijpt. Werk Wooosh op beide apparaten bij."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Drugie urządzenie wysłało coś, czego Wooosh nie rozumie. Zaktualizuj Wooosh na obu urządzeniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O outro dispositivo enviou algo que o Wooosh não entendeu. Atualize o Wooosh nos dois dispositivos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Другое устройство отправило данные, которые Wooosh не понимает. Обновите Wooosh на обоих устройствах."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den andra enheten skickade något Wooosh inte förstod. Uppdatera Wooosh på båda enheterna."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方设备发送了 Wooosh 无法识别的内容。请在两台设备上更新 Wooosh。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對方裝置傳送了 Wooosh 無法識別的內容。請在兩台裝置上更新 Wooosh。"
          }
        }
      }
    },
    "error_qr_key_mismatch": {
      "comment": "Core error: the device that answered is not the one in the pairing code.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das antwortende Gerät ist nicht das aus dem Kopplungscode. Wooosh hat die Kopplung abgebrochen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device that answered is not the one in the pairing code. Wooosh stopped pairing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dispositivo que ha respondido no es el del código de vinculación. Wooosh ha detenido la vinculación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'appareil qui a répondu n'est pas celui du code d'association. Wooosh a interrompu l'association."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il dispositivo che ha risposto non è quello del codice di abbinamento. Wooosh ha interrotto l'abbinamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "応答したデバイスは、ペアリングコードのデバイスではありません。Wooosh はペアリングを中止しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "응답한 기기가 페어링 코드의 기기와 다릅니다. Wooosh가 페어링을 중단했습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het apparaat dat antwoordde is niet dat uit de koppelcode. Wooosh heeft het koppelen gestopt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Urządzenie, które odpowiedziało, nie jest tym z kodu parowania. Wooosh przerwał parowanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O dispositivo que respondeu não é o do código de pareamento. O Wooosh interrompeu o pareamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ответившее устройство не совпадает с указанным в коде связи. Wooosh прервал связывание."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Enheten som svarade är inte den i parkopplingskoden. Wooosh avbröt parkopplingen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "响应的设备与配对码中的设备不符。Wooosh 已停止配对。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回應的裝置與配對碼中的裝置不符。Wooosh 已停止配對。"
          }
        }
      }
    },
    "error_relay_file_too_large": {
      "comment": "Transfer refused: relayed route and a file over the limit. %1$@/%1$s is a size like \"100 MB\".",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh konnte die beiden Geräte nicht direkt verbinden. Über eine indirekte Verbindung müssen Dateien kleiner als %1$@ sein. Versuche es erneut oder nutze ein Netzwerk, das eine direkte Verbindung erlaubt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh could not connect the two devices directly. Over an indirect connection, files must be under %1$@. Try again, or use a network that allows a direct connection."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh no pudo conectar los dos dispositivos directamente. Con una conexión indirecta, los archivos deben ser menores de %1$@. Inténtalo de nuevo o usa una red que permita una conexión directa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh n'a pas pu connecter les deux appareils directement. Sur une connexion indirecte, les fichiers doivent faire moins de %1$@. Réessayez ou utilisez un réseau qui autorise une connexion directe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh non è riuscito a collegare i due dispositivi direttamente. Su una connessione indiretta i file devono essere sotto %1$@. Riprova oppure usa una rete che consenta una connessione diretta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh は 2 台のデバイスを直接つなげられませんでした。間接的な接続では、ファイルは %1$@ 未満である必要があります。もう一度試すか、直接接続できるネットワークをお使いください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh가 두 기기를 직접 연결하지 못했습니다. 간접 연결에서는 파일이 %1$@ 미만이어야 합니다. 다시 시도하거나 직접 연결이 가능한 네트워크를 사용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh kon de twee apparaten niet rechtstreeks verbinden. Via een indirecte verbinding moeten bestanden kleiner zijn dan %1$@. Probeer het opnieuw of gebruik een netwerk dat een directe verbinding toelaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh nie mógł połączyć obu urządzeń bezpośrednio. Przy połączeniu pośrednim pliki muszą być mniejsze niż %1$@. Spróbuj ponownie lub użyj sieci pozwalającej na połączenie bezpośrednie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Wooosh não conseguiu conectar os dois dispositivos diretamente. Em uma conexão indireta, os arquivos precisam ter menos de %1$@. Tente de novo ou use uma rede que permita conexão direta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh не смог соединить устройства напрямую. При непрямом соединении файлы должны быть меньше %1$@. Попробуйте снова или используйте сеть, допускающую прямое соединение."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh kunde inte koppla ihop enheterna direkt. Över en indirekt anslutning måste filer vara mindre än %1$@. Försök igen eller använd ett nätverk som tillåter en direkt anslutning."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh 无法让两台设备直连。通过间接连接时，文件必须小于 %1$@。请重试，或改用允许直连的网络。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh 無法讓兩台裝置直連。透過間接連線時，檔案必須小於 %1$@。請重試，或改用允許直連的網路。"
          }
        }
      }
    },
    "error_relay_url_invalid": {
      "comment": "Shown when the core rejected the relay address.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Relay-Adresse ist ungültig. Wooosh hat die vorherige Einstellung behalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That relay address is not valid. Wooosh kept the previous setting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa dirección de relé no es válida. Wooosh mantuvo el ajuste anterior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette adresse de relais n'est pas valide. Wooosh a conservé le réglage précédent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo indirizzo del relay non è valido. Wooosh ha mantenuto l'impostazione precedente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのリレーのアドレスは無効です。Wooosh は以前の設定を維持しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "릴레이 주소가 올바르지 않습니다. Wooosh는 이전 설정을 유지했습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat relay-adres is ongeldig. Wooosh heeft de vorige instelling behouden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten adres przekaźnika jest nieprawidłowy. Wooosh zachował poprzednie ustawienie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse endereço de relay não é válido. O Wooosh manteve a configuração anterior."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот адрес ретранслятора недействителен. Wooosh сохранил прежнюю настройку."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den reläadressen är ogiltig. Wooosh behöll den tidigare inställningen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该中继地址无效，Wooosh 保留了先前的设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該中繼位址無效，Wooosh 保留了先前的設定。"
          }
        }
      }
    },
    "error_sas_timeout": {
      "comment": "Shown when the other device did not confirm the verification code in time.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das andere Gerät hat nicht rechtzeitig bestätigt. Starte die Kopplung erneut, wenn beide Geräte bereit sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The other device didn't confirm in time. Start pairing again when both devices are ready."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El otro dispositivo no ha confirmado a tiempo. Empieza a vincular de nuevo cuando ambos dispositivos estén listos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'autre appareil n'a pas confirmé à temps. Relancez l'association lorsque les deux appareils sont prêts."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'altro dispositivo non ha confermato in tempo. Riavvia l'abbinamento quando entrambi i dispositivi sono pronti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手のデバイスが時間内に確認しませんでした。両方のデバイスの準備ができてから、もう一度ペアリングを開始してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상대 기기가 제한 시간 안에 확인하지 않았습니다. 두 기기가 모두 준비되면 페어링을 다시 시작하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het andere apparaat heeft niet op tijd bevestigd. Begin opnieuw met koppelen als beide apparaten klaar zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Drugie urządzenie nie potwierdziło na czas. Rozpocznij parowanie ponownie, gdy oba urządzenia będą gotowe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O outro dispositivo não confirmou a tempo. Comece o pareamento de novo quando os dois dispositivos estiverem prontos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Другое устройство не подтвердило вовремя. Начните связывание заново, когда оба устройства будут готовы."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den andra enheten bekräftade inte i tid. Starta parkopplingen igen när båda enheterna är redo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方设备未及时确认。请在两台设备都准备好后重新开始配对。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對方裝置未及時確認。請在兩台裝置都準備好後重新開始配對。"
          }
        }
      }
    },
