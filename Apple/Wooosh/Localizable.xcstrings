    "settings_relay_off_footer": {
      "comment": "What switching the internet path off does.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh schaltet Internetübertragungen aus und kontaktiert nichts. Senden funktioniert nur zwischen Geräten im selben Netzwerk."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh turns internet transfers off and contacts nothing. Sending works only between devices on the same network."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh desactiva las transferencias por internet y no contacta con nada. Enviar solo funciona entre dispositivos de la misma red."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh désactive les transferts par Internet et ne contacte rien. L'envoi ne fonctionne qu'entre appareils du même réseau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh disattiva i trasferimenti via internet e non contatta nulla. L'invio funziona solo tra dispositivi sulla stessa rete."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh はインターネット転送をオフにし、どこにも接続しません。送信は同じネットワーク上のデバイス間でのみ行えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh가 인터넷 전송을 끄고 아무 곳에도 연결하지 않습니다. 전송은 같은 네트워크의 기기 사이에서만 가능합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh schakelt internetoverdrachten uit en benadert niets. Versturen werkt alleen tussen apparaten op hetzelfde netwerk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh wyłącza przesyłanie przez internet i z niczym się nie łączy. Wysyłanie działa tylko między urządzeniami w tej samej sieci."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Wooosh desativa as transferências pela internet e não contata nada. O envio funciona só entre dispositivos na mesma rede."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh отключает передачу через интернет и ни к чему не обращается. Отправка работает только между устройствами в одной сети."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh stänger av internetöverföringar och kontaktar ingenting. Att skicka fungerar bara mellan enheter i samma nätverk."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh 关闭互联网传输，不连接任何服务。仅可在同一网络的设备之间发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh 關閉網際網路傳輸，不連線任何服務。僅可在同一網路的裝置之間傳送。"
          }
        }
      }
    },
