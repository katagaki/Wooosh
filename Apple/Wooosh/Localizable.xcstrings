    "settings_visibility_everyone_desc": {
      "comment": "Description of the Everyone option.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Gerät in der Nähe kann dieses Gerät sehen und ihm Dateien anbieten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Any nearby device can see this device and offer files to it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquier dispositivo cercano puede ver este dispositivo y ofrecerle archivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N'importe quel appareil à proximité peut voir cet appareil et lui proposer des fichiers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualsiasi dispositivo nelle vicinanze può vedere questo dispositivo e proporgli dei file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "近くのすべてのデバイスがこのデバイスを検出し、ファイルを送ろうとすることができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "근처의 모든 기기가 이 기기를 찾아 파일 전송을 요청할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk apparaat in de buurt kan dit apparaat zien en er bestanden aan aanbieden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każde urządzenie w pobliżu widzi to urządzenie i może zaproponować mu pliki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualquer dispositivo por perto pode ver este dispositivo e oferecer arquivos a ele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Любое устройство поблизости видит это устройство и может предложить ему файлы."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla enheter i närheten kan se den här enheten och erbjuda den filer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "附近的任何设备都能看到这台设备并向它发送文件请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "附近的任何裝置都能看到這台裝置並向它提出傳送請求。"
          }
        }
      }
    },
    "settings_visibility_off": {
