          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo codice funziona una sola volta e scade dopo 2 minuti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコードは 1 回だけ使用でき、2 分で期限切れになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 코드는 한 번만 사용할 수 있으며 2분 후에 만료됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze code werkt één keer en verloopt na 2 minuten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten kod działa raz i wygasa po 2 minutach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este código funciona uma vez só e expira depois de 2 minutos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Код действует один раз и истекает через 2 минуты."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Koden fungerar en gång och upphör att gälla efter 2 minuter."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此配对码只能使用一次，2 分钟后失效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此配對碼只能使用一次，2 分鐘後失效。"
          }
        }
      }
    },
    "pairing_success_body": {
      "comment": "Explanation after a successful pairing.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh vertraut diesem Gerät ab sofort. Du musst die Bestätigungswörter nicht mehr abgleichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh trusts this device from now on. You will not need to compare verification phrases with it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A partir de ahora Wooosh confía en este dispositivo. No hará falta que vuelvas a comparar frases de verificación con él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh fait désormais confiance à cet appareil. Vous n'aurez plus à comparer les phrases de vérification avec lui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "D'ora in poi Wooosh si fida di questo dispositivo. Non dovrai più confrontare le frasi di verifica con lui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh は今後このデバイスを信頼します。次回以降、確認フレーズを照合する必要はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 Wooosh는 이 기기를 신뢰합니다. 앞으로는 확인 문구를 비교할 필요가 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh vertrouwt dit apparaat vanaf nu. Je hoeft geen verificatiezinnen meer met dit apparaat te vergelijken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Od teraz Wooosh ufa temu urządzeniu. Nie będzie już trzeba porównywać z nim fraz weryfikacyjnych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A partir de agora o Wooosh confia neste dispositivo. Você não vai precisar comparar frases de verificação com ele de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Теперь Wooosh доверяет этому устройству. Сверять проверочные фразы с ним больше не потребуется."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh litar på den här enheten från och med nu. Du behöver inte jämföra verifieringsfraser med den igen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从现在起，Wooosh 会信任这台设备。你不需要再与它核对验证短语。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從現在起，Wooosh 會信任這台裝置。你不需要再與它核對驗證短語。"
          }
        }
      }
    },
