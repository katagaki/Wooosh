    "pairing_progress_body": {
      "comment": "Explanation while a pairing attempt runs.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass das andere Gerät entsperrt und den Kopplungscode auf dem Bildschirm. Beide Geräte müssen im selben WLAN sein. Das kann einige Sekunden dauern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the other device unlocked with its pairing code on screen. Both devices need to be on the same Wi-Fi network. This can take a few seconds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén el otro dispositivo desbloqueado con su código de vinculación en pantalla. Ambos dispositivos deben estar en la misma red Wi-Fi. Puede tardar unos segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez l'autre appareil déverrouillé avec son code d'association affiché. Les deux appareils doivent être sur le même réseau Wi-Fi. Cela peut prendre quelques secondes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni l'altro dispositivo sbloccato con il suo codice di abbinamento sullo schermo. Entrambi i dispositivi devono essere sulla stessa rete Wi-Fi. Possono volerci alcuni secondi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手のデバイスのロックを解除したまま、ペアリングコードを画面に表示しておいてください。両方のデバイスが同じ Wi-Fi ネットワークに接続されている必要があります。数秒かかることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상대 기기의 잠금을 해제한 상태로 페어링 코드를 화면에 띄워 두세요. 두 기기가 같은 Wi-Fi 네트워크에 있어야 합니다. 몇 초 걸릴 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd het andere apparaat ontgrendeld met de koppelcode in beeld. Beide apparaten moeten in hetzelfde wifinetwerk zitten. Dit kan een paar seconden duren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostaw drugie urządzenie odblokowane z kodem parowania na ekranie. Oba urządzenia muszą być w tej samej sieci Wi-Fi. Może to potrwać kilka sekund."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha o outro dispositivo desbloqueado com o código de pareamento na tela. Os dois dispositivos precisam estar na mesma rede Wi-Fi. Pode levar alguns segundos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставьте другое устройство разблокированным, с кодом связи на экране. Оба устройства должны быть в одной сети Wi-Fi. Это может занять несколько секунд."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Låt den andra enheten vara upplåst med parkopplingskoden på skärmen. Båda enheterna måste vara i samma Wi-Fi-nätverk. Det kan ta några sekunder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请让另一台设备保持解锁，并在屏幕上显示配对码。两台设备需要在同一 Wi-Fi 网络中。这可能需要几秒钟。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請讓另一台裝置保持解鎖，並在螢幕上顯示配對碼。兩台裝置需要在同一 Wi-Fi 網路中。這可能需要幾秒鐘。"
          }
        }
      }
    },
