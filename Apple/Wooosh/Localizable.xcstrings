    "verify_prompt_peer": {
      "comment": "Prompt on the sending device while an unpaired device decides. %1$s is a device name.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ wird dich bitten, die Übereinstimmung dieser Wörter zu bestätigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ will ask you to confirm that these words match."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ te pedirá que confirmes que estas palabras coinciden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ vous demandera de confirmer que ces mots correspondent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ti chiederà di confermare che queste parole coincidono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ から、これらの単語が一致するかどうかの確認を求められます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@에서 이 단어들이 일치하는지 확인을 요청합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ vraagt je te bevestigen dat deze woorden overeenkomen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Urządzenie %1$@ poprosi o potwierdzenie, że te słowa są takie same."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ vai pedir que você confirme que essas palavras são iguais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройство %1$@ попросит подтвердить, что эти слова совпадают."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ber dig bekräfta att orden stämmer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 会请你确认这些词语是否一致。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 會請你確認這些詞語是否一致。"
          }
        }
      }
    },
    "verify_your_phrase_a11y": {
      "comment": "Accessibility description of the verification phrase block. %1$s is the phrase.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Bestätigungswörter: %1$@. Das andere Gerät bittet dich, die Übereinstimmung zu bestätigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your verification phrase: %1$@. The other device will ask you to confirm that these words match."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu frase de verificación: %1$@. El otro dispositivo te pedirá que confirmes que estas palabras coinciden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre phrase de vérification : %1$@. L'autre appareil vous demandera de confirmer que ces mots correspondent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua frase di verifica: %1$@. L'altro dispositivo ti chiederà di confermare che queste parole coincidono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの確認フレーズ: %1$@。相手のデバイスは、これらの単語が一致するかどうかの確認を求めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 확인 문구: %1$@. 상대 기기가 이 단어들이 일치하는지 확인을 요청합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je verificatiezin: %1$@. Het andere apparaat vraagt je te bevestigen dat deze woorden overeenkomen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja fraza weryfikacyjna: %1$@. Drugie urządzenie poprosi o potwierdzenie, że te słowa są takie same."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua frase de verificação: %1$@. O outro dispositivo vai pedir que você confirme que essas palavras são iguais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша проверочная фраза: %1$@. Другое устройство попросит подтвердить, что эти слова совпадают."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din verifieringsfras: %1$@. Den andra enheten ber dig bekräfta att orden stämmer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的验证短语：%1$@。对方设备会请你确认这些词语是否一致。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的驗證短語：%1$@。對方裝置會請你確認這些詞語是否一致。"
          }
        }
      }
    },
    "verify_your_phrase_body": {
      "comment": "Explanation under this device's own verification phrase.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das andere Gerät bittet dich vor dem Annehmen, die Übereinstimmung dieser Wörter zu bestätigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The other device will ask you to confirm that these words match before it accepts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El otro dispositivo te pedirá que confirmes que estas palabras coinciden antes de aceptar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'autre appareil vous demandera de confirmer que ces mots correspondent avant d'accepter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'altro dispositivo ti chiederà di confermare che queste parole coincidono prima di accettare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手のデバイスは、受け取る前にこれらの単語が一致するかどうかの確認を求めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상대 기기는 파일을 받기 전에 이 단어들이 일치하는지 확인을 요청합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het andere apparaat vraagt je te bevestigen dat deze woorden overeenkomen voordat het accepteert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Drugie urządzenie poprosi o potwierdzenie, że te słowa są takie same, zanim przyjmie pliki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O outro dispositivo vai pedir que você confirme que essas palavras são iguais antes de aceitar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед приёмом другое устройство попросит подтвердить, что эти слова совпадают."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den andra enheten ber dig bekräfta att orden stämmer innan den tar emot."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方设备在接受之前，会请你确认这些词语是否一致。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對方裝置在接受之前，會請你確認這些詞語是否一致。"
          }
        }
      }
    },
