    "settings_paired_devices_empty": {
      "comment": "Shown when nothing is paired yet.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine gekoppelten Geräte. Füge über „Gerät koppeln“ eines hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No paired devices yet. Use Pair a Device to add one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay dispositivos vinculados. Usa «Vincular un dispositivo» para añadir uno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun appareil associé pour l'instant. Utilisez « Associer un appareil » pour en ajouter un."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun dispositivo abbinato per ora. Usa «Abbina un dispositivo» per aggiungerne uno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリング済みのデバイスはまだありません。「デバイスをペアリング」から追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 페어링된 기기가 없습니다. ‘기기 페어링’에서 추가하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen gekoppelde apparaten. Gebruik ‘Apparaat koppelen’ om er een toe te voegen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma jeszcze sparowanych urządzeń. Użyj opcji „Sparuj urządzenie”, aby dodać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há dispositivos pareados. Use “Parear um dispositivo” para adicionar um."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Связанных устройств пока нет. Добавьте одно через «Связать устройство»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga parkopplade enheter än. Använd ”Parkoppla en enhet” för att lägga till en."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有已配对的设备。使用“配对设备”添加一台。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有已配對的裝置。使用「配對裝置」新增一台。"
          }
        }
      }
    },
    "settings_paired_devices_footer": {
      "comment": "Explanation of what unpairing does.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Aufheben der Kopplung wird der gespeicherte Schlüssel entfernt. Die nächste Übertragung von diesem Gerät gilt als nicht vertrauenswürdig, bis du erneut koppelst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unpairing removes the stored key. The next transfer from that device is untrusted until you pair again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al desvincular se elimina la clave guardada. La próxima transferencia de ese dispositivo no será de confianza hasta que vuelvas a vincularlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dissociation supprime la clé enregistrée. Le prochain transfert depuis cet appareil ne sera pas approuvé tant que vous ne l'aurez pas réassocié."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuovere l'abbinamento elimina la chiave salvata. Il prossimo trasferimento da quel dispositivo non sarà attendibile finché non lo abbini di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリングを解除すると、保存されているキーが削除されます。次にそのデバイスから転送があった場合、再度ペアリングするまで信頼されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페어링을 해제하면 저장된 키가 삭제됩니다. 다시 페어링하기 전까지 그 기기에서 오는 다음 전송은 신뢰되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontkoppelen verwijdert de bewaarde sleutel. De volgende overdracht van dat apparaat is niet vertrouwd totdat je opnieuw koppelt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozłączenie pary usuwa zapisany klucz. Kolejny transfer z tego urządzenia nie będzie zaufany do czasu ponownego sparowania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desparear remove a chave salva. A próxima transferência desse dispositivo não será confiável até você parear de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрыв связи удаляет сохранённый ключ. Следующая передача с этого устройства не будет доверенной, пока вы не свяжетесь заново."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att ta bort parkopplingen raderar den sparade nyckeln. Nästa överföring från enheten är inte betrodd förrän du parkopplar igen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消配对会删除已保存的密钥。在你重新配对之前，来自该设备的下一次传输将不受信任。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取消配對會刪除已儲存的金鑰。在你重新配對之前，來自該裝置的下一次傳輸將不受信任。"
          }
        }
      }
    },
