    "error_pairing_dropped": {
      "comment": "Shown when the connection died part-way through pairing.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung ist vor dem Ende der Kopplung abgebrochen. Versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection dropped before pairing finished. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conexión se ha interrumpido antes de terminar la vinculación. Vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion a été interrompue avant la fin de l'association. Réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La connessione è caduta prima che l'abbinamento finisse. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリングが完了する前に接続が切断されました。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페어링이 끝나기 전에 연결이 끊어졌습니다. 다시 시도해 주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De verbinding is weggevallen voordat het koppelen klaar was. Probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połączenie zerwało się przed zakończeniem parowania. Spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conexão caiu antes de o pareamento terminar. Tente de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Соединение прервалось до завершения связывания. Повторите попытку."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anslutningen bröts innan parkopplingen blev klar. Försök igen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对完成前连接中断。请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "配對完成前連線中斷。請重試。"
          }
        }
      }
    },
    "error_pairing_expired": {
      "comment": "Core error: the pairing code is no longer valid.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Kopplungscode ist abgelaufen. Lass dir einen neuen geben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That pairing code has expired. Ask for a fresh one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese código de vinculación ha caducado. Pide uno nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce code d'association a expiré. Demandez-en un nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel codice di abbinamento è scaduto. Chiedine uno nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのペアリングコードは期限切れです。新しいコードを表示してもらってください。"
