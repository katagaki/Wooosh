    "offer_unpaired_warning": {
      "comment": "Warning above the sender's verification phrase on the accept sheet.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht gekoppelt. Prüfe, ob die Wörter unten mit denen auf dem Bildschirm des Absenders übereinstimmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not paired. Check that the words below match the ones on the sender's screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin vincular. Comprueba que las palabras de abajo coincidan con las de la pantalla del remitente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non associé. Vérifiez que les mots ci-dessous correspondent à ceux affichés sur l'écran de l'expéditeur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non abbinato. Verifica che le parole qui sotto coincidano con quelle sullo schermo del mittente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリングされていません。下の単語が、送信側の画面に表示されている単語と一致するか確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페어링되지 않았습니다. 아래 단어가 보내는 기기 화면에 표시된 단어와 같은지 확인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet gekoppeld. Controleer of de woorden hieronder overeenkomen met die op het scherm van de afzender."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak sparowania. Sprawdź, czy poniższe słowa są takie same jak na ekranie urządzenia wysyłającego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não pareado. Confira se as palavras abaixo são iguais às da tela de quem está enviando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройство не связано. Проверьте, совпадают ли слова ниже со словами на экране отправителя."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inte parkopplad. Kontrollera att orden nedan stämmer med dem på avsändarens skärm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未配对。请确认下面的词语与发送方屏幕上显示的一致。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未配對。請確認下方的詞語與傳送端螢幕上顯示的一致。"
          }
        }
      }
    },
    "other_device_body": {
      "comment": "Instructions on the redeem screen.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanne den Code des Geräts, an das du senden willst, oder füge ihn unten ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan the code from the device you want to send to, or paste it below."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanea el código del dispositivo al que quieres enviar, o pégalo abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannez le code de l'appareil auquel vous voulez envoyer, ou collez-le ci-dessous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scansiona il codice del dispositivo a cui vuoi inviare, oppure incollalo qui sotto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信先のデバイスのコードをスキャンするか、下に貼り付けてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보낼 기기의 코드를 스캔하거나 아래에 붙여넣으세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan de code van het apparaat waarnaar je wilt sturen, of plak hem hieronder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeskanuj kod urządzenia, do którego chcesz wysłać, albo wklej go poniżej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escaneie o código do dispositivo para o qual quer enviar, ou cole abaixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отсканируйте код устройства, которому хотите отправить, или вставьте его ниже."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skanna koden från enheten du vill skicka till, eller klistra in den nedan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描要发送到的设备上的代码，或在下方粘贴。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掃描要傳送到的裝置上的代碼，或在下方貼上。"
          }
        }
      }
    },
    "other_device_connecting_body": {
      "comment": "Shown while a ticket is being redeemed.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Verbindung über das Internet dauert länger als im lokalen Netzwerk."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecting over the internet takes longer than on a local network."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectarse por internet tarda más que en una red local."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se connecter par Internet prend plus de temps que sur un réseau local."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Connettersi via internet richiede più tempo che su una rete locale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インターネット経由の接続は、ローカルネットワークより時間がかかります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인터넷 연결은 로컬 네트워크보다 오래 걸립니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinden via internet duurt langer dan op een lokaal netwerk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Łączenie przez internet trwa dłużej niż w sieci lokalnej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectar pela internet demora mais do que numa rede local."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключение через интернет занимает больше времени, чем в локальной сети."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att ansluta via internet tar längre tid än i ett lokalt nätverk."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过互联网连接比在本地网络中更慢。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過網際網路連線比在本地網路中更慢。"
          }
        }
      }
    },
    "other_device_prompt": {
      "comment": "Asks which direction the internet transfer goes.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Mal wird ein Code gebraucht. Beim Senden wird einer angezeigt, beim Empfangen einer gescannt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A code is needed each time. Sending shows one, receiving scans one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se necesita un código cada vez. Al enviar se muestra uno, al recibir se escanea uno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un code est nécessaire à chaque fois. L'envoi en affiche un, la réception en scanne un."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Serve un codice ogni volta. Inviando se ne mostra uno, ricevendo se ne scansiona uno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎回コードが必要です。送信側は表示し、受信側はスキャンします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매번 코드가 필요합니다. 보낼 때는 표시하고, 받을 때는 스캔합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke keer is een code nodig. Verzenden toont er een, ontvangen scant er een."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za każdym razem potrzebny jest kod. Wysyłanie go pokazuje, odbieranie skanuje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É preciso um código a cada vez. Enviar mostra um, receber escaneia um."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый раз нужен код. При отправке он показывается, при получении сканируется."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En kod behövs varje gång. Att skicka visar en, att ta emot skannar en."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次都需要一个代码。发送时显示，接收时扫描。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每次都需要一個代碼。傳送時顯示，接收時掃描。"
          }
        }
      }
    },
