    "error_pairing_code_expired_detail": {
      "comment": "Shown when a pasted or scanned pairing code was already too old.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Kopplungscode ist abgelaufen. Kopplungscodes gelten zwei Minuten. Lass auf dem anderen Gerät einen neuen anzeigen und scanne ihn erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That pairing code has expired. Pairing codes last two minutes. Show a fresh one on the other device and scan it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese código de vinculación ha caducado. Los códigos duran dos minutos. Muestra uno nuevo en el otro dispositivo y vuelve a escanearlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce code d'association a expiré. Les codes d'association durent deux minutes. Affichez-en un nouveau sur l'autre appareil et scannez-le à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel codice di abbinamento è scaduto. I codici durano due minuti. Mostrane uno nuovo sull'altro dispositivo e scansionalo di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのペアリングコードは期限切れです。ペアリングコードの有効期間は 2 分です。相手のデバイスで新しいコードを表示して、もう一度スキャンしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 페어링 코드가 만료되었습니다. 페어링 코드는 2분간 유효합니다. 상대 기기에 새 코드를 띄운 뒤 다시 스캔하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Die koppelcode is verlopen. Koppelcodes zijn twee minuten geldig. Laat een nieuwe zien op het andere apparaat en scan die opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten kod parowania wygasł. Kody parowania działają przez dwie minuty. Wyświetl nowy na drugim urządzeniu i zeskanuj go ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse código de pareamento expirou. Os códigos valem dois minutos. Mostre um novo no outro dispositivo e escaneie de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Срок действия этого кода связи истёк. Коды действуют две минуты. Покажите новый код на другом устройстве и отсканируйте его снова."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Parkopplingskoden har upphört att gälla. Koder gäller i två minuter. Visa en ny på den andra enheten och skanna den igen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该配对码已失效。配对码有效期为两分钟。请在另一台设备上显示新的配对码并重新扫描。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該配對碼已失效。配對碼有效期為兩分鐘。請在另一台裝置上顯示新的配對碼並重新掃描。"
          }
        }
      }
    },
    "error_pairing_code_rejected": {
      "comment": "Shown when the other device refused a pairing code that had already been used.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das andere Gerät hat diesen Kopplungscode abgelehnt. Jeder Code funktioniert nur einmal. Lass einen neuen anzeigen und scanne ihn erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The other device rejected that pairing code. Each code works only once. Show a fresh one and scan it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El otro dispositivo ha rechazado ese código de vinculación. Cada código sirve una sola vez. Muestra uno nuevo y vuelve a escanearlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'autre appareil a refusé ce code d'association. Chaque code ne fonctionne qu'une fois. Affichez-en un nouveau et scannez-le à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'altro dispositivo ha rifiutato quel codice di abbinamento. Ogni codice funziona una sola volta. Mostrane uno nuovo e scansionalo di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手のデバイスがそのペアリングコードを拒否しました。各コードは 1 回だけ使用できます。新しいコードを表示して、もう一度スキャンしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상대 기기가 해당 페어링 코드를 거부했습니다. 각 코드는 한 번만 사용할 수 있습니다. 새 코드를 띄운 뒤 다시 스캔하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het andere apparaat heeft die koppelcode geweigerd. Elke code werkt maar één keer. Laat een nieuwe zien en scan die opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Drugie urządzenie odrzuciło ten kod parowania. Każdy kod działa tylko raz. Wyświetl nowy i zeskanuj go ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O outro dispositivo recusou esse código de pareamento. Cada código funciona uma vez só. Mostre um novo e escaneie de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Другое устройство отклонило этот код связи. Каждый код действует один раз. Покажите новый и отсканируйте его снова."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den andra enheten avvisade parkopplingskoden. Varje kod fungerar bara en gång. Visa en ny och skanna den igen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方设备拒绝了该配对码。每个配对码只能使用一次。请显示新的配对码并重新扫描。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對方裝置拒絕了該配對碼。每組配對碼只能使用一次。請顯示新的配對碼並重新掃描。"
          }
        }
      }
    },
    "error_pairing_declined": {
      "comment": "Shown when the person on the other device refused to pair.",
      "extractionState": "manual",
      "localizations": {
        "de": {
