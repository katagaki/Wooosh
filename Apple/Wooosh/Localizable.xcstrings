    "settings_relay_custom_footer": {
      "comment": "What the custom relay option does.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh nutzt das eingetragene Iroh-Relay. Codes von diesem Gerät weisen das andere Gerät an, es ebenfalls zu nutzen, sodass nur dieses Gerät die Adresse braucht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh uses the Iroh relay you enter. Codes from this device tell the other device to use it too, so only this device needs the address."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh usa el relé de Iroh que indiques. Los códigos de este dispositivo le dicen al otro que lo use también, así que solo este dispositivo necesita la dirección."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh utilise le relais Iroh que vous indiquez. Les codes de cet appareil indiquent à l'autre de l'utiliser aussi, donc seul cet appareil a besoin de l'adresse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh usa il relay Iroh che inserisci. I codici di questo dispositivo dicono all'altro di usarlo a sua volta, quindi solo questo dispositivo ha bisogno dell'indirizzo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh は入力した Iroh リレーを使います。このデバイスのコードは相手のデバイスにも同じリレーを使うよう伝えるため、アドレスが必要なのはこのデバイスだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh는 입력한 Iroh 릴레이를 사용합니다. 이 기기의 코드가 상대 기기에도 같은 릴레이를 쓰도록 알려주므로, 주소는 이 기기에만 필요합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh gebruikt de Iroh-relay die je invult. Codes van dit apparaat vertellen het andere apparaat die ook te gebruiken, dus alleen dit apparaat heeft het adres nodig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh korzysta z podanego przekaźnika Iroh. Kody z tego urządzenia mówią drugiemu, aby też go użyło, więc adres jest potrzebny tylko na tym urządzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Wooosh usa o relay Iroh que você informar. Os códigos deste dispositivo dizem ao outro para usá-lo também, então só este dispositivo precisa do endereço."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh использует указанный ретранслятор Iroh. Коды с этого устройства сообщают другому использовать его же, поэтому адрес нужен только здесь."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh använder det Iroh-relä du anger. Koder från den här enheten säger åt den andra enheten att också använda det, så bara den här enheten behöver adressen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh 使用你填写的 Iroh 中继。本设备生成的代码会让对方设备也使用它，因此只有本设备需要填写地址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh 使用你填寫的 Iroh 中繼。本裝置產生的代碼會讓對方裝置也使用它，因此只有本裝置需要填寫位址。"
          }
        }
      }
    },
