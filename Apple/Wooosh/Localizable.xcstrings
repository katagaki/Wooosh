    "empty_body": {
      "comment": "Body of the empty device list.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geräte, auf denen Wooosh im selben WLAN läuft, erscheinen hier automatisch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Devices running Wooosh on the same Wi-Fi network appear here automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los dispositivos que ejecutan Wooosh en la misma red Wi-Fi aparecen aquí automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les appareils qui utilisent Wooosh sur le même réseau Wi-Fi apparaissent ici automatiquement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dispositivi che usano Wooosh sulla stessa rete Wi-Fi compaiono qui automaticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ Wi-Fi ネットワークで Wooosh を実行しているデバイスが、ここに自動的に表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 Wi-Fi 네트워크에서 Wooosh를 실행 중인 기기가 여기에 자동으로 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apparaten waarop Wooosh draait in hetzelfde wifinetwerk verschijnen hier automatisch."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Urządzenia z Wooosh w tej samej sieci Wi-Fi pojawiają się tu automatycznie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dispositivos com o Wooosh na mesma rede Wi-Fi aparecem aqui automaticamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройства с Wooosh в той же сети Wi-Fi появляются здесь автоматически."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Enheter som kör Wooosh i samma Wi-Fi-nätverk visas här automatiskt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一 Wi-Fi 网络中运行 Wooosh 的设备会自动显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同一 Wi-Fi 網路中執行 Wooosh 的裝置會自動顯示在這裡。"
          }
        }
      }
    },
