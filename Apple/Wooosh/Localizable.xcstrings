    "sas_body": {
      "comment": "Instructions for comparing the six-digit verification code.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beide Geräte zeigen einen sechsstelligen Code. Fahre nur fort, wenn beide Codes gleich sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both devices show a six-digit code. Continue only if the two codes are the same."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambos dispositivos muestran un código de seis dígitos. Continúa solo si los dos códigos son iguales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les deux appareils affichent un code à six chiffres. Ne continuez que si les deux codes sont identiques."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrambi i dispositivi mostrano un codice di sei cifre. Continua solo se i due codici sono uguali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両方のデバイスに 6 桁のコードが表示されます。2 つのコードが同じ場合にのみ続行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 기기에 6자리 코드가 표시됩니다. 두 코드가 같을 때만 계속하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beide apparaten tonen een code van zes cijfers. Ga alleen verder als de twee codes gelijk zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oba urządzenia pokazują sześciocyfrowy kod. Kontynuuj tylko wtedy, gdy kody są takie same."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dois dispositivos mostram um código de seis dígitos. Continue só se os dois códigos forem iguais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оба устройства показывают шестизначный код. Продолжайте, только если коды совпадают."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Båda enheterna visar en sexsiffrig kod. Fortsätt bara om koderna är lika."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两台设备都会显示一个六位代码。只有两个代码相同时才继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩台裝置都會顯示一組六位數代碼。只有兩組代碼相同時才繼續。"
          }
        }
      }
    },
