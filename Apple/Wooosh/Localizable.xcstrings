    "internet_expiry": {
      "comment": "Expiry rule for an internet code.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Code funktioniert einmal und läuft nach zwei Minuten ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This code works once and expires after two minutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este código funciona una vez y caduca a los dos minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce code fonctionne une seule fois et expire après deux minutes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo codice funziona una volta e scade dopo due minuti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコードは 1 回だけ使え、2 分で期限切れになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 코드는 한 번만 사용할 수 있으며 2분 후 만료됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze code werkt één keer en verloopt na twee minuten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten kod działa raz i wygasa po dwóch minutach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este código funciona uma vez e expira após dois minutos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Код действует один раз и истекает через две минуты."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här koden fungerar en gång och upphör efter två minuter."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此代码仅可使用一次，两分钟后失效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此代碼僅可使用一次，兩分鐘後失效。"
          }
        }
      }
    },
    "internet_intro_body": {
      "comment": "Explains the internet path before any code is requested.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh kann sich auch über das Internet verbinden, für ein Gerät außerhalb dieses Netzwerks. Hole einen Code und gib ihn dem Gerät, das die Dateien sendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh can also connect over the internet, for a device that is not on this network. Get a code, then give it to the device that will send the files."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh también puede conectarse por internet, para un dispositivo que no está en esta red. Obtén un código y dáselo al dispositivo que enviará los archivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh peut aussi se connecter par Internet, pour un appareil qui n'est pas sur ce réseau. Obtenez un code, puis donnez-le à l'appareil qui enverra les fichiers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh può connettersi anche via internet, per un dispositivo che non è su questa rete. Richiedi un codice e dallo al dispositivo che invierà i file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh は同じネットワークにないデバイスとも、インターネット経由で接続できます。コードを取得し、ファイルを送る側のデバイスに渡してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh는 같은 네트워크에 없는 기기와도 인터넷으로 연결할 수 있습니다. 코드를 받아 파일을 보낼 기기에 전달하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh kan ook via internet verbinden, voor een apparaat dat niet op dit netwerk zit. Vraag een code aan en geef die aan het apparaat dat de bestanden verstuurt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh może połączyć się także przez internet, z urządzeniem spoza tej sieci. Pobierz kod i przekaż go urządzeniu, które wyśle pliki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Wooosh também pode conectar pela internet, para um dispositivo que não está nesta rede. Obtenha um código e entregue-o ao dispositivo que vai enviar os arquivos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh может подключаться и через интернет, к устройству вне этой сети. Получите код и передайте его устройству, которое будет отправлять файлы."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh kan även ansluta via internet, till en enhet som inte finns i det här nätverket. Hämta en kod och ge den till enheten som ska skicka filerna."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh 也可以通过互联网连接不在此网络中的设备。获取一个代码，然后交给要发送文件的设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh 也可以透過網際網路連線到不在此網路中的裝置。取得一個代碼，然後交給要傳送檔案的裝置。"
          }
        }
      }
    },
    "internet_off_body": {
      "comment": "Shown in the Internet tab when the path is switched off.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Internetübertragungen sind aus. Schalte sie in den Einstellungen ein, um einen Code zu holen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Internet transfers are off. Turn them on in Settings to get a code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las transferencias por internet están desactivadas. Actívalas en Ajustes para obtener un código."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les transferts par Internet sont désactivés. Activez-les dans les Réglages pour obtenir un code."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I trasferimenti via internet sono disattivati. Attivali nelle Impostazioni per ottenere un codice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インターネット転送はオフです。コードを取得するには設定でオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인터넷 전송이 꺼져 있습니다. 코드를 받으려면 설정에서 켜세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Internetoverdrachten staan uit. Schakel ze in bij Instellingen om een code op te halen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesyłanie przez internet jest wyłączone. Włącz je w Ustawieniach, aby pobrać kod."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As transferências pela internet estão desativadas. Ative-as em Ajustes para obter um código."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Передача через интернет выключена. Включите её в настройках, чтобы получить код."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Internetöverföringar är av. Slå på dem i Inställningar för att hämta en kod."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "互联网传输已关闭。请在设置中开启后再获取代码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "網際網路傳輸已關閉。請在設定中開啟後再取得代碼。"
          }
        }
      }
    },
    "internet_preparing": {
      "comment": "Shown while the internet code is being minted.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Code wird vorbereitet. Das dauert ein paar Sekunden."
          }
        },
        "en": {
