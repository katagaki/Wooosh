    "settings_relay_public_footer": {
      "comment": "What the public relay option does.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh nutzt die kostenlosen Relays von Iroh, die mit anderen Apps geteilt werden. Ihre Verfügbarkeit ist nicht garantiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh uses the free relays provided by Iroh, shared with other apps. They are not guaranteed to be available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh usa los relés gratuitos que ofrece Iroh, compartidos con otras apps. No se garantiza su disponibilidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh utilise les relais gratuits fournis par Iroh, partagés avec d'autres apps. Leur disponibilité n'est pas garantie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh usa i relay gratuiti forniti da Iroh, condivisi con altre app. La loro disponibilità non è garantita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh は Iroh が提供する無料のリレーを使います。他のアプリと共有されており、可用性は保証されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh는 Iroh가 제공하는 무료 릴레이를 사용합니다. 다른 앱과 공유되며 가용성은 보장되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh gebruikt de gratis relays van Iroh, die met andere apps worden gedeeld. Beschikbaarheid is niet gegarandeerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh korzysta z darmowych przekaźników udostępnianych przez Iroh, współdzielonych z innymi aplikacjami. Ich dostępność nie jest gwarantowana."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Wooosh usa os relays gratuitos fornecidos pela Iroh, compartilhados com outros apps. A disponibilidade não é garantida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh использует бесплатные ретрансляторы Iroh, общие с другими приложениями. Их доступность не гарантирована."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh använder de gratis reläer som Iroh tillhandahåller, delade med andra appar. Tillgängligheten är inte garanterad."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh 使用 Iroh 提供的免费中继，与其他应用共享，其可用性没有保证。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh 使用 Iroh 提供的免費中繼，與其他 App 共享，其可用性沒有保證。"
          }
        }
      }
    },
