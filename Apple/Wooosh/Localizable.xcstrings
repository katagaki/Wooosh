    "notification_channel_desc": {
      "comment": "Description of the Android notification channel for transfers.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortschritt laufender Übertragungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Progress of transfers that are running."
          }
        },
        "es": {
