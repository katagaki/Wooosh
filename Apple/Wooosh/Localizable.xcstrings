    "internet_ready_body": {
      "comment": "Instructions above a minted internet code.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanne diesen Code mit dem Gerät, das die Dateien sendet, oder kopiere ihn und sende ihn über einen Weg, dem du vertraust."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan this code with the device that will send the files, or copy it and send it over a channel you trust."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanea este código con el dispositivo que enviará los archivos, o cópialo y envíalo por un canal de confianza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannez ce code avec l'appareil qui enverra les fichiers, ou copiez-le et envoyez-le par un canal de confiance."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scansiona questo codice con il dispositivo che invierà i file, oppure copialo e invialo tramite un canale di cui ti fidi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルを送る側のデバイスでこのコードをスキャンするか、コピーして信頼できる方法で送ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일을 보낼 기기로 이 코드를 스캔하거나, 복사해 신뢰할 수 있는 경로로 보내세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan deze code met het apparaat dat de bestanden verstuurt, of kopieer hem en stuur hem via een kanaal dat je vertrouwt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeskanuj ten kod urządzeniem, które wyśle pliki, albo skopiuj go i prześlij zaufanym kanałem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escaneie este código com o dispositivo que vai enviar os arquivos, ou copie e envie por um canal confiável."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отсканируйте этот код устройством, которое будет отправлять файлы, или скопируйте его и передайте по надёжному каналу."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skanna den här koden med enheten som ska skicka filerna, eller kopiera den och skicka den via en kanal du litar på."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用要发送文件的设备扫描此代码，或复制后通过你信任的渠道发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用要傳送檔案的裝置掃描此代碼，或複製後透過你信任的管道傳送。"
          }
        }
      }
    },
    "internet_relay_note": {
      "comment": "Discloses that requesting a code contacts a relay.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für einen Code wird ein öffentliches Relay kontaktiert, damit sich beide Geräte finden. Dateien laufen weiterhin direkt zwischen ihnen, sobald eine direkte Route besteht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Getting a code contacts a public relay so the two devices can find each other. Files still travel straight between them whenever a direct route exists."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtener un código contacta con un relé público para que ambos dispositivos se encuentren. Los archivos siguen viajando directamente entre ellos siempre que exista una ruta directa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtenir un code contacte un relais public pour que les deux appareils se trouvent. Les fichiers circulent toujours directement entre eux dès qu'une route directe existe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiedere un codice contatta un relay pubblico perché i due dispositivi si trovino. I file viaggiano comunque direttamente tra loro quando esiste un percorso diretto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードの取得時は、2 台のデバイスが互いを見つけられるように公開リレーへ接続します。直接の経路が使える場合、ファイルは引き続きデバイス間を直接転送されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코드를 받을 때 두 기기가 서로를 찾을 수 있도록 공개 릴레이에 연결합니다. 직접 경로가 있으면 파일은 여전히 두 기기 사이를 바로 오갑니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor een code wordt een openbare relay benaderd zodat beide apparaten elkaar kunnen vinden. Bestanden gaan nog steeds rechtstreeks tussen de apparaten zodra er een directe route is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobranie kodu łączy się z publicznym przekaźnikiem, aby oba urządzenia mogły się odnaleźć. Pliki nadal wędrują bezpośrednio między nimi, gdy istnieje bezpośrednia trasa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Obter um código contata um relay público para que os dois dispositivos se encontrem. Os arquivos continuam indo diretamente entre eles sempre que existe uma rota direta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При получении кода выполняется обращение к публичному ретранслятору, чтобы устройства нашли друг друга. Файлы по-прежнему идут напрямую, когда прямой маршрут доступен."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att hämta en kod kontaktar ett publikt relä så att enheterna kan hitta varandra. Filer går fortfarande direkt mellan dem så snart det finns en direkt väg."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "获取代码时会连接公共中继，让两台设备找到彼此。只要存在直连路径，文件仍会在两台设备之间直接传输。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取得代碼時會連線公共中繼，讓兩台裝置找到彼此。只要有直連路徑，檔案仍會在兩台裝置之間直接傳輸。"
          }
        }
      }
    },
    "internet_send_intro_body": {
