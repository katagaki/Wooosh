    "verify_phrase_body": {
      "comment": "Settings explanation of the verification phrase.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lies diese Wörter laut vor, um zu bestätigen, dass du mit dem richtigen Gerät sprichst. Sie stammen aus dem Identitätsschlüssel dieses Geräts, der es nie verlässt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read these words aloud to confirm that you are talking to the right device. They come from this device's identity key, which never leaves it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee estas palabras en voz alta para confirmar que estás hablando con el dispositivo correcto. Proceden de la clave de identidad de este dispositivo, que nunca sale de él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisez ces mots à voix haute pour confirmer que vous communiquez avec le bon appareil. Ils proviennent de la clé d'identité de cet appareil, qui ne le quitte jamais."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Leggi queste parole ad alta voce per confermare che stai comunicando con il dispositivo giusto. Derivano dalla chiave di identità di questo dispositivo, che non lo lascia mai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの単語を声に出して読み、正しいデバイスと通信していることを確認してください。単語はこのデバイスの識別キーから作られ、キーが外に出ることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 단어들을 소리 내어 읽어 올바른 기기와 연결되었는지 확인하세요. 단어는 이 기기의 신원 키에서 만들어지며, 키는 기기 밖으로 나가지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lees deze woorden hardop voor om te bevestigen dat je met het juiste apparaat praat. Ze komen uit de identiteitssleutel van dit apparaat, die het nooit verlaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeczytaj te słowa na głos, aby potwierdzić, że łączysz się z właściwym urządzeniem. Pochodzą z klucza tożsamości tego urządzenia, który nigdy go nie opuszcza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Leia estas palavras em voz alta para confirmar que você está falando com o dispositivo certo. Elas vêm da chave de identidade deste dispositivo, que nunca sai dele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прочитайте эти слова вслух, чтобы убедиться, что вы связываетесь с нужным устройством. Они получены из ключа этого устройства, который никогда его не покидает."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Läs orden högt för att bekräfta att du pratar med rätt enhet. De kommer från enhetens identitetsnyckel, som aldrig lämnar den."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大声读出这些词语，确认你连接的是正确的设备。它们由这台设备的身份密钥生成，密钥永远不会离开本机。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "大聲唸出這些詞語，確認你連線的是正確的裝置。它們由這台裝置的身分金鑰產生，金鑰永遠不會離開本機。"
          }
        }
      }
    },
