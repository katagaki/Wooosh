          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh couldn't work out how to reach “%1$@”. It may have just gone offline."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh no ha podido determinar cómo llegar a «%1$@». Puede que se haya desconectado hace un momento."
          }
