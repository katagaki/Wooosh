        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 페어링 코드가 만료되었습니다. 새 코드를 요청하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Die koppelcode is verlopen. Vraag om een nieuwe."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten kod parowania wygasł. Poproś o nowy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse código de pareamento expirou. Peça um novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Срок действия этого кода связи истёк. Попросите новый."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
