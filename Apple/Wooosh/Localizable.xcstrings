        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse dispositivo está apresentando uma chave de segurança diferente da usada no pareamento. Pareie de novo para continuar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
