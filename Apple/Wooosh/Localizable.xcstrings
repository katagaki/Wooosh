      }
    },
    "pairing_show_body": {
      "comment": "Instructions above this device's own pairing code.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanne diesen Code mit dem anderen Gerät oder kopiere den Kopplungscode und sende ihn über einen Weg, dem du vertraust."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan this code with the other device, or copy the pairing code and send it over a channel you trust."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanea este código con el otro dispositivo, o copia el código de vinculación y envíalo por un canal de confianza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannez ce code avec l'autre appareil, ou copiez le code d'association et envoyez-le par un canal de confiance."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scansiona questo codice con l'altro dispositivo, oppure copia il codice di abbinamento e invialo tramite un canale di cui ti fidi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコードを相手のデバイスでスキャンするか、ペアリングコードをコピーして信頼できる方法で送ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상대 기기로 이 코드를 스캔하거나, 페어링 코드를 복사해 신뢰할 수 있는 방법으로 보내세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan deze code met het andere apparaat, of kopieer de koppelcode en stuur die via een kanaal dat je vertrouwt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeskanuj ten kod drugim urządzeniem albo skopiuj kod parowania i wyślij go zaufanym kanałem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escaneie este código com o outro dispositivo, ou copie o código de pareamento e envie por um canal em que você confia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отсканируйте этот код другим устройством или скопируйте код связи и передайте его надёжным способом."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skanna koden med den andra enheten, eller kopiera parkopplingskoden och skicka den via en kanal du litar på."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用另一台设备扫描此二维码，或复制配对码并通过你信任的渠道发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用另一台裝置掃描此 QR 碼，或複製配對碼並透過你信任的管道傳送。"
          }
        }
      }
    },
    "pairing_show_expiry": {
      "comment": "Note under the pairing code explaining that it is short-lived.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Code funktioniert einmal und läuft nach 2 Minuten ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This code works once and expires after 2 minutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este código sirve una sola vez y caduca a los 2 minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
