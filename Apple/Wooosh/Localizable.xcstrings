    "error_io": {
      "comment": "Core error: a file could not be read or written.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh konnte eine Datei nicht lesen oder schreiben. Prüfe den freien Speicher und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh could not read or write a file. Check that there is free space and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Wooosh no ha podido leer o escribir un archivo. Comprueba que haya espacio libre y vuelve a intentarlo."
