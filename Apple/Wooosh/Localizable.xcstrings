    "settings_pairing_footer": {
      "comment": "Explanation of what pairing buys the user.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gekoppelte Geräte bestätigen ihre Identität automatisch. Bei Übertragungen zwischen ihnen musst du nie Bestätigungswörter abgleichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paired devices confirm each other's identity automatically, so transfers between them never ask you to compare verification phrases."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los dispositivos vinculados confirman su identidad automáticamente, así que las transferencias entre ellos nunca te piden comparar frases de verificación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les appareils associés confirment automatiquement leur identité : les transferts entre eux ne vous demandent jamais de comparer des phrases de vérification."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dispositivi abbinati confermano la reciproca identità in automatico, quindi i trasferimenti fra loro non ti chiedono mai di confrontare frasi di verifica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリング済みのデバイスは互いの身元を自動的に確認するため、その間の転送で確認フレーズを照合する必要はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페어링된 기기는 서로의 신원을 자동으로 확인하므로, 기기 간 전송에서 확인 문구를 비교하지 않아도 됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gekoppelde apparaten bevestigen elkaars identiteit automatisch, dus bij overdrachten tussen die apparaten hoef je nooit verificatiezinnen te vergelijken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparowane urządzenia automatycznie potwierdzają swoją tożsamość, więc transfery między nimi nigdy nie wymagają porównywania fraz weryfikacyjnych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dispositivos pareados confirmam a identidade um do outro automaticamente, então as transferências entre eles nunca pedem para comparar frases de verificação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Связанные устройства подтверждают личность друг друга автоматически, поэтому при передачах между ними сверять проверочные фразы не нужно."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Parkopplade enheter bekräftar varandras identitet automatiskt, så överföringar mellan dem ber dig aldrig jämföra verifieringsfraser."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已配对的设备会自动确认彼此的身份，因此它们之间的传输不会再要求你核对验证短语。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已配對的裝置會自動確認彼此的身分，因此它們之間的傳輸不會再要求你核對驗證短語。"
          }
        }
      }
    },
