    "settings_visibility_off_desc": {
      "comment": "Description of the Off option.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät ist verborgen und kann keine Dateien empfangen. Du siehst andere Geräte weiterhin und kannst ihnen etwas senden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device is hidden and cannot receive files. You can still see other devices and send to them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo está oculto y no puede recibir archivos. Aún puedes ver otros dispositivos y enviarles archivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil est masqué et ne peut rien recevoir. Vous voyez toujours les autres appareils et pouvez leur envoyer des fichiers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo dispositivo è nascosto e non può ricevere file. Puoi comunque vedere gli altri dispositivi e inviare loro dei file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスは非表示で、ファイルを受信できません。他のデバイスを見て送信することはできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기는 숨겨져 있어 파일을 받을 수 없습니다. 다른 기기를 보고 파일을 보낼 수는 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit apparaat is verborgen en kan geen bestanden ontvangen. Je ziet andere apparaten nog steeds en kunt bestanden naar ze sturen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To urządzenie jest ukryte i nie może odbierać plików. Nadal widzisz inne urządzenia i możesz im wysyłać pliki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo está oculto e não pode receber arquivos. Você ainda vê os outros dispositivos e pode enviar arquivos para eles."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это устройство скрыто и не может принимать файлы. Другие устройства по-прежнему видны, и им можно отправлять файлы."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här enheten är dold och kan inte ta emot filer. Du ser fortfarande andra enheter och kan skicka till dem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台设备已隐藏，无法接收文件。你仍然可以看到其他设备并向它们发送文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台裝置已隱藏，無法接收檔案。你仍然可以看到其他裝置並傳送檔案給它們。"
          }
        }
      }
    },
    "settings_visibility_paired": {
      "comment": "Option: only paired devices may send.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur gekoppelte Geräte"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paired Devices Only"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo dispositivos vinculados"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appareils associés uniquement"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo dispositivi abbinati"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリング済みのデバイスのみ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페어링된 기기만"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen gekoppelde apparaten"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko sparowane urządzenia"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só dispositivos pareados"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только связанные устройства"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Endast parkopplade enheter"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅已配对的设备"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅已配對的裝置"
          }
        }
      }
    },
    "settings_visibility_paired_desc": {
      "comment": "Description of the Paired Devices Only option.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geräte in der Nähe sehen dieses Gerät, aber nur gekoppelte Geräte können ihm etwas senden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nearby devices can see this device, but only paired devices can send to it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los dispositivos cercanos ven este dispositivo, pero solo los vinculados pueden enviarle archivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les appareils à proximité voient cet appareil, mais seuls les appareils associés peuvent lui envoyer des fichiers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dispositivi nelle vicinanze vedono questo dispositivo, ma solo quelli abbinati possono inviargli file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "近くのデバイスからこのデバイスは見えますが、送信できるのはペアリング済みのデバイスだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "근처 기기에서 이 기기를 볼 수는 있지만, 파일을 보낼 수 있는 것은 페어링된 기기뿐입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apparaten in de buurt zien dit apparaat, maar alleen gekoppelde apparaten kunnen er iets naartoe sturen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Urządzenia w pobliżu widzą to urządzenie, ale wysyłać mogą tylko sparowane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dispositivos por perto veem este dispositivo, mas só os pareados podem enviar arquivos para ele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройства поблизости видят это устройство, но отправлять могут только связанные."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Enheter i närheten ser den här enheten, men bara parkopplade enheter kan skicka till den."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "附近的设备能看到这台设备，但只有已配对的设备才能向它发送文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
