    "empty_visibility_everyone": {
      "comment": "Extra line on the empty device list when everyone can see this device.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Geräte in der Nähe können dieses Gerät sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everyone nearby can see this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquier dispositivo cercano puede ver este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les appareils à proximité peuvent voir cet appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i dispositivi nelle vicinanze possono vedere questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "近くのすべてのデバイスから、このデバイスが見えています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "근처의 모든 기기에서 이 기기를 볼 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle apparaten in de buurt kunnen dit apparaat zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie urządzenia w pobliżu widzą to urządzenie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualquer dispositivo por perto pode ver este dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это устройство видно всем устройствам поблизости."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla enheter i närheten kan se den här enheten."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "附近的所有设备都能看到这台设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "附近的所有裝置都能看到這台裝置。"
          }
        }
      }
    },
    "empty_visibility_off": {
      "comment": "Extra line on the empty device list when this device is hidden.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät ist verborgen und kann keine Dateien empfangen. Du siehst andere Geräte weiterhin und kannst ihnen etwas senden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device is hidden and cannot receive files. You can still see other devices and send to them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo está oculto y no puede recibir archivos. Aún puedes ver otros dispositivos y enviarles archivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil est masqué et ne peut rien recevoir. Vous voyez toujours les autres appareils et pouvez leur envoyer des fichiers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo dispositivo è nascosto e non può ricevere file. Puoi comunque vedere gli altri dispositivi e inviare loro dei file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスは非表示で、ファイルを受信できません。他のデバイスを見て送信することはできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기는 숨겨져 있어 파일을 받을 수 없습니다. 다른 기기를 보고 파일을 보낼 수는 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit apparaat is verborgen en kan geen bestanden ontvangen. Je ziet andere apparaten nog steeds en kunt bestanden naar ze sturen."
          }
        },
        "pl": {
