            "value": "Auf diesem Gerät läuft eine nicht kompatible Wooosh-Version. Aktualisiere Wooosh auf beiden Geräten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That device runs a version of Wooosh that is not compatible. Update Wooosh on both devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese dispositivo usa una versión de Wooosh que no es compatible. Actualiza Wooosh en ambos dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil utilise une version de Wooosh incompatible. Mettez Wooosh à jour sur les deux appareils."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel dispositivo usa una versione di Wooosh non compatibile. Aggiorna Wooosh su entrambi i dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのデバイスは互換性のないバージョンの Wooosh を実行しています。両方のデバイスで Wooosh を更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 기기는 호환되지 않는 버전의 Wooosh를 실행 중입니다. 두 기기에서 Wooosh를 업데이트하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat apparaat gebruikt een versie van Wooosh die niet compatibel is. Werk Wooosh op beide apparaten bij."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To urządzenie ma niezgodną wersję Wooosh. Zaktualizuj Wooosh na obu urządzeniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse dispositivo usa uma versão do Wooosh que não é compatível. Atualize o Wooosh nos dois dispositivos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом устройстве несовместимая версия Wooosh. Обновите Wooosh на обоих устройствах."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Enheten kör en version av Wooosh som inte är kompatibel. Uppdatera Wooosh på båda enheterna."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该设备运行的 Wooosh 版本不兼容。请在两台设备上更新 Wooosh。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該裝置執行的 Wooosh 版本不相容。請在兩台裝置上更新 Wooosh。"
          }
        }
      }
    },
