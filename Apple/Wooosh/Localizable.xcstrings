    "keychanged_presented_unknown": {
      "comment": "Shown when the other device's key could not be read at all.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht verfügbar: Die Verbindung ist fehlgeschlagen, bevor der Schlüssel gelesen werden konnte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not available: the connection failed before its key could be read."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No disponible: la conexión falló antes de poder leer la clave."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indisponible : la connexion a échoué avant que la clé puisse être lue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non disponibile: la connessione è fallita prima che la chiave potesse essere letta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取得できません: キーを読み取る前に接続が失敗しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인할 수 없음: 키를 읽기 전에 연결이 실패했습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet beschikbaar: de verbinding mislukte voordat de sleutel gelezen kon worden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niedostępne: połączenie nie powiodło się, zanim udało się odczytać klucz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Indisponível: a conexão falhou antes de a chave poder ser lida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Недоступно: соединение прервалось до того, как удалось прочитать ключ."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inte tillgänglig: anslutningen misslyckades innan nyckeln kunde läsas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法获取：在读取密钥之前连接就失败了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法取得：在讀取金鑰之前連線就失敗了。"
          }
        }
      }
    },
    "keychanged_row_warning": {
      "comment": "Warning on a paired-device row whose key changed.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlüssel geändert. Zum Fortfahren erneut koppeln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Key changed. Pair again to continue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave ha cambiado. Vuelve a vincular para continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clé modifiée. Associez à nouveau pour continuer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiave cambiata. Abbina di nuovo per continuare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーが変更されました。続けるには再度ペアリングしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키가 변경되었습니다. 계속하려면 다시 페어링하세요."
          }
        },
        "nl": {
          "stringUnit": {
