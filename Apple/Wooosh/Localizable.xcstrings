        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ изменился. Свяжитесь заново, чтобы продолжить."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyckeln har ändrats. Parkoppla igen för att fortsätta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密钥已更改。重新配对后才能继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "金鑰已變更。重新配對後才能繼續。"
          }
        }
      }
    },
