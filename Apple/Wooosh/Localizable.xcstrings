    "pairing_scan_body": {
      "comment": "Instructions on the scan tab.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Richte die Kamera auf den Kopplungscode, den Wooosh auf dem anderen Gerät anzeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Point the camera at the pairing code shown in Wooosh on the other device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apunta la cámara al código de vinculación que muestra Wooosh en el otro dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dirigez l'appareil photo vers le code d'association affiché par Wooosh sur l'autre appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inquadra con la fotocamera il codice di abbinamento mostrato da Wooosh sull'altro dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手のデバイスの Wooosh に表示されているペアリングコードにカメラを向けてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상대 기기의 Wooosh에 표시된 페어링 코드에 카메라를 비추세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Richt de camera op de koppelcode die Wooosh op het andere apparaat toont."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skieruj aparat na kod parowania wyświetlany przez Wooosh na drugim urządzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aponte a câmera para o código de pareamento que o Wooosh mostra no outro dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наведите камеру на код связи, показанный в Wooosh на другом устройстве."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rikta kameran mot parkopplingskoden som Wooosh visar på den andra enheten."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将摄像头对准另一台设备上 Wooosh 显示的配对码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將相機對準另一台裝置上 Wooosh 顯示的配對碼。"
          }
        }
      }
    },
    "pairing_scan_body_desktop": {
      "comment": "Instructions on a computer, which pairs by pasting rather than scanning.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiere den Kopplungscode vom anderen Gerät und füge ihn unten ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy the pairing code from the other device and paste it below."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia el código de vinculación del otro dispositivo y pégalo abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiez le code d'association depuis l'autre appareil et collez-le ci-dessous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia il codice di abbinamento dall'altro dispositivo e incollalo qui sotto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手のデバイスからペアリングコードをコピーして、下に貼り付けてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상대 기기에서 페어링 코드를 복사해 아래에 붙여넣으세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopieer de koppelcode van het andere apparaat en plak die hieronder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skopiuj kod parowania z drugiego urządzenia i wklej go poniżej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie o código de pareamento do outro dispositivo e cole abaixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопируйте код связи с другого устройства и вставьте его ниже."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiera parkopplingskoden från den andra enheten och klistra in den nedan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从另一台设备复制配对码，然后粘贴到下方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從另一台裝置複製配對碼，然後貼到下方。"
          }
        }
      }
    },
    "pairing_scan_focus_hint": {
      "comment": "Instructions under the live camera view.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Richte die Kamera auf den Kopplungscode des anderen Geräts. Zum Fokussieren tippen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Point the camera at the pairing code on the other device. Tap to focus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apunta la cámara al código de vinculación del otro dispositivo. Toca para enfocar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dirigez l'appareil photo vers le code d'association de l'autre appareil. Touchez pour faire la mise au point."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inquadra il codice di abbinamento dell'altro dispositivo. Tocca per mettere a fuoco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手のデバイスのペアリングコードにカメラを向けてください。タップするとピントが合います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상대 기기의 페어링 코드에 카메라를 비추세요. 탭하면 초점이 맞춰집니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Richt de camera op de koppelcode van het andere apparaat. Tik om scherp te stellen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skieruj aparat na kod parowania drugiego urządzenia. Dotknij, aby ustawić ostrość."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aponte a câmera para o código de pareamento do outro dispositivo. Toque para focar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наведите камеру на код связи другого устройства. Нажмите, чтобы навести резкость."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rikta kameran mot den andra enhetens parkopplingskod. Tryck för att fokusera."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将摄像头对准另一台设备上的配对码。轻点可对焦。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將相機對準另一台裝置上的配對碼。點一下可對焦。"
          }
        }
      }
    },
    "pairing_scan_prompt": {
      "comment": "Prompt shown over the camera while scanning.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanne den Code, der auf dem anderen Gerät angezeigt wird"
          }
        },
        "en": {
